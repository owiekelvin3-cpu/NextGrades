# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for teacher file uploads, avatars, and signed download URLs (server only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL (required in production) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email — Resend (required for contact + password reset) ───
RESEND_API_KEY=re_xxxxxxxx
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=NextGrades
CONTACT_FORM_TO_EMAIL=you@example.com

# Optional email branding
# RESEND_REPLY_TO_EMAIL=
# ADMIN_NOTIFICATION_EMAIL=
# NEXT_PUBLIC_EMAIL_LOGO_URL=
# SUPPORT_EMAIL=
# COMPANY_ADDRESS=

# ── Auth ─────────────────────────────────────────────────────
# Production: email verification is ON by default. Set false only for local dev.
# REQUIRE_EMAIL_VERIFICATION=false
# One-time admin bootstrap (local dev only — blocked in production)
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ALLOW_ADMIN_BOOTSTRAP=true

# ── Stripe (required for paid plans) ───────────────────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROUP_MONTHLY=price_...
# STRIPE_PRICE_GROUP_YEARLY=price_...
# STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
# STRIPE_PRICE_INDIVIDUAL_YEARLY=price_...
# STRIPE_PRICE_RESOURCE_MONTHLY=price_...
# STRIPE_PRICE_RESOURCE_YEARLY=price_...

# ── AI chat (at least one recommended) ───────────────────────
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# ── Zoom OAuth (live classes — server only, never expose secret to client) ──
# Create app: https://marketplace.zoom.us/ → Build → OAuth
#
# IMPORTANT — multi-teacher OAuth:
# Development credentials ONLY work for the Zoom account that created the app.
# External teachers get "Application Not Found" until you use Production credentials.
#
# 1. In Zoom Marketplace, submit Beta Test or publish the app.
# 2. Copy Client ID + Secret from the **Production** tab (not Development).
# 3. Add your redirect URL under Production → Redirect URL for OAuth.
# 4. Set ZOOM_OAUTH_ENV=production
#
# ZOOM_OAUTH_ENV=production
# ZOOM_CLIENT_ID=your-production-client-id
# ZOOM_CLIENT_SECRET=your-production-client-secret
# ZOOM_REDIRECT_URI=https://yourdomain.com/api/zoom/callback
#
# Optional: separate dev vs prod credentials
# ZOOM_DEVELOPMENT_CLIENT_ID=
# ZOOM_DEVELOPMENT_CLIENT_SECRET=
# ZOOM_DEVELOPMENT_REDIRECT_URI=http://localhost:3000/api/zoom/callback
# ZOOM_PRODUCTION_CLIENT_ID=
# ZOOM_PRODUCTION_CLIENT_SECRET=
# ZOOM_PRODUCTION_REDIRECT_URI=https://yourdomain.com/api/zoom/callback
#
# See nextgrades-app/ZOOM_OAUTH_SETUP.md for full setup steps.

# ── Consultation scheduling (optional) ───────────────────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/consultation

# ── Web push (optional) ──────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=support@yourdomain.com

# ── Database migrations (local only — never commit password) ─
# Supabase Dashboard → Project Settings → Database → password
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres
# Then run: npm run db:apply-pdf
