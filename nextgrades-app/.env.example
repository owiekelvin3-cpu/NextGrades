# NextGrades — copy to .env.local and fill in real values. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for registration OTP, admin user creation, and server-side auth
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=re_your_resend_api_key
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=NextGrades
RESEND_REPLY_TO_EMAIL=support@yourdomain.com
CONTACT_FORM_TO_EMAIL=admin@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
COMPANY_ADDRESS=NextGrades GmbH, Germany
# Optional: hosted logo URL for email templates
# NEXT_PUBLIC_EMAIL_LOGO_URL=https://yourdomain.com/logo.png

# Stripe (optional — payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_GROUP_MONTHLY=price_xxx
STRIPE_PRICE_GROUP_YEARLY=price_xxx
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_xxx
STRIPE_PRICE_INDIVIDUAL_YEARLY=price_xxx
STRIPE_PRICE_RESOURCE_MONTHLY=price_xxx
STRIPE_PRICE_RESOURCE_YEARLY=price_xxx

# Zoom (optional — live sessions)
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# AI chat (optional — at least one provider)
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=sk-or-your_openrouter_key
TOGETHER_API_KEY=your_together_api_key
