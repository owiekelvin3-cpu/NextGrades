# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for teacher file uploads, avatars, and signed download URLs (server only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL (required in production) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email — Resend (primary for signup, contact, password reset, notifications) ───
# 1. Create API key at https://resend.com/api-keys
# 2. Verify domain at https://resend.com/domains (e.g. nextgrades.at)
# 3. Set RESEND_SENDER_EMAIL to noreply@yourdomain.com (NOT onboarding@resend.dev in production)
RESEND_API_KEY=re_xxxxxxxx
RESEND_SENDER_EMAIL=noreply@nextgrades.at
RESEND_SENDER_NAME=NextGrade
CONTACT_FORM_TO_EMAIL=you@example.com

# Optional — only used if Resend fails (not needed when Resend domain is verified)
# AUTH_SMTP_HOST=
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM=

# Optional email branding
# RESEND_REPLY_TO_EMAIL=
# ADMIN_NOTIFICATION_EMAIL=
# NEXT_PUBLIC_EMAIL_LOGO_URL=
# SUPPORT_EMAIL=support@nextgrades.at
# COMPANY_ADDRESS=

# ── Security (production) ────────────────────────────────────
# Random 32+ char secret for encrypting pending signup passwords (required in production)
# REGISTRATION_SECRET=
# Bearer token for /api/health/setup and /api/health/storage in production
# INTERNAL_OPS_TOKEN=

# ── Auth ─────────────────────────────────────────────────────
# Allow public self-registration (set false for invite-only)
# Invite-only by default — admin creates accounts; users set password on first login.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
# Supabase Auth: disable automatic auth emails if you use Resend for everything.
# Authentication → Email Templates → turn OFF duplicate sends where noted in docs.
# Production: verification ON by default. Set false only for local dev without Resend.
# Signup: 6-digit code before account is created (recommended in production)
# REQUIRE_SIGNUP_EMAIL_VERIFICATION=true
# NEXT_PUBLIC_REQUIRE_SIGNUP_EMAIL_VERIFICATION=true
# Login: optional code after password (usually false)
# REQUIRE_LOGIN_EMAIL_VERIFICATION=false
# NEXT_PUBLIC_REQUIRE_LOGIN_EMAIL_VERIFICATION=false
# Legacy fallback for both when the specific vars are unset:
# REQUIRE_EMAIL_VERIFICATION=true
# NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=true
# Login email OTP (second step after password) — on by default in production
# REQUIRE_LOGIN_EMAIL_VERIFICATION=true
# NEXT_PUBLIC_REQUIRE_LOGIN_EMAIL_VERIFICATION=true
# Required in production (32+ random chars — MFA cookies, OTP hashing, trusted devices)
AUTH_SESSION_SECRET=replace-with-32-plus-character-random-secret
# Protect detailed health diagnostics in production
HEALTH_OPS_TOKEN=
# Cloudflare Turnstile (optional bot protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# One-time admin bootstrap (local dev only — blocked in production)
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ALLOW_ADMIN_BOOTSTRAP=true

# ── Stripe (subscriptions) ───────────────────────────────────
# Webhook URL: https://YOUR-DOMAIN/api/stripe/webhook
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_RESOURCE_MONTHLY=price_...
# STRIPE_PRICE_RESOURCE_YEARLY=price_...
# STRIPE_PRICE_GROUP_MONTHLY=price_...
# STRIPE_PRICE_GROUP_YEARLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
# Run: npm run stripe:setup-prices (with STRIPE_SECRET_KEY set) to create prices

# ── AI chat (at least one recommended) ───────────────────────
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# ── Zoom OAuth (teacher live classes) ─────────────────────────
# ZOOM_OAUTH_ENV=production
# ZOOM_PRODUCTION_CLIENT_ID=
# ZOOM_PRODUCTION_CLIENT_SECRET=
# ZOOM_PRODUCTION_REDIRECT_URI=https://www.nextgrades.at/api/zoom/callback
# Or use ZOOM_CLIENT_ID / ZOOM_CLIENT_SECRET / ZOOM_REDIRECT_URI as fallbacks

# ── Consultation scheduling (optional) ───────────────────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/consultation

# ── Web push (optional) ──────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=support@yourdomain.com

# ── Database migrations (local only — never commit password) ─
# Supabase Dashboard → Project Settings → Database → password
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres
# Then run: npm run db:apply-pdf
